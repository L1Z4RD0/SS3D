DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/zola_app
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Seed inicial (usado por `python -m app.seed`). Si dejas SEED_ADMIN_PASSWORD
# vacío, el script genera una contraseña aleatoria y la imprime una sola vez.
# Nunca reutilices aquí una contraseña que ya uses en otro sistema (BD, etc).
SEED_ADMIN_USERNAME=Lizard
SEED_ADMIN_PASSWORD=
